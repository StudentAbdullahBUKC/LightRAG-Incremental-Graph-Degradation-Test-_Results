    <node id="Master Peter Cratchit">
      <data key="d0">Master Peter Cratchit</data>
      <data key="d1">person</data>
      <data key="d2">Master Peter is another of Bob's sons, who is proud to be dressed in his father's old shirt collar.&lt;SEP&gt;Master Peter Cratchit is the father of several children and works as a clerk in a counting-house.</data>
      <data key="d3">chunk-5f14044ab5836af865c1e895c3e69f02&lt;SEP&gt;chunk-4ff9deb2924e688bbce0e0754c1c6c61&lt;SEP&gt;chunk-d83de16f004bc6df79c898ceebb845ae</data>
