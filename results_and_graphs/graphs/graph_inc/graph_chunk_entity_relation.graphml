      <data key="d6" />
    </node>
    <node id="Robin Crusoe">
      <data key="d0">Robin Crusoe</data>
      <data key="d1">person</data>
      <data key="d2">Robin Crusoe is a character who appears in one of Scrooge's memories and is nicknamed "The Parrot".&lt;SEP&gt;Robin Crusoe is a person who sailed around an island and was called by the Parrot when he returned home.</data>
      <data key="d3">chunk-5ac48fca8de324fa3a899664c908f275&lt;SEP&gt;chunk-947e3553c13534c9202f0f1a5c3291f5</data>
