      <data key="d5">1778857415</data>
      <data key="d6" />
    </node>
    <node id="Tiny Tim">
      <data key="d0">Tiny Tim</data>
      <data key="d1">person</data>
      <data key="d2">Tiny Tim is Bob Cratchit's youngest son, suffering from a debilitating illness that has left him unable to walk or play with other children.&lt;SEP&gt;Tiny Tim is a young boy who suffers from a physical affliction and brings joy to his family despite their hardships.</data>
      <data key="d3">chunk-5eeebd4a7c0b1417f8eb4d15431f546d&lt;SEP&gt;chunk-4ff9deb2924e688bbce0e0754c1c6c61&lt;SEP&gt;chunk-0f65a52cdced73f0bcc13216f1ce39e8&lt;SEP&gt;chunk-df28678965f69c7e76c314f07ac980b7&lt;SEP&gt;chunk-17a39495d7b79a72917d7f65a38a5e46&lt;SEP&gt;chunk-46e6c7e69332f5941d7559d38ab18692&lt;SEP&gt;chunk-1396694e41876e83b97376904aee5073&lt;SEP&gt;chunk-118ca942f4f3c9502142773f3fdd20d1&lt;SEP&gt;chunk-7d515d836ef3c169d415fdd151180e25&lt;SEP&gt;chunk-6b8276083af810245d6150ef51adb0c5&lt;SEP&gt;chunk-7b1f20d45706bc18474add4f6ec6ab5d&lt;SEP&gt;chunk-ffd1a7ae5fb09fc2adae0d7ed19d8e16&lt;SEP&gt;chunk-d83de16f004bc6df79c898ceebb845ae</data>
