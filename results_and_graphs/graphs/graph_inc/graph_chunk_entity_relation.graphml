    </node>
    <node id="Friday">
      <data key="d0">Friday</data>
      <data key="d1">creature</data>
      <data key="d2">Friday is possibly a reference to a character from Robinson Crusoe, running for his life towards a creek in the story.</data>
      <data key="d3">chunk-947e3553c13534c9202f0f1a5c3291f5</data>
      <data key="d4">unknown_source</data>
