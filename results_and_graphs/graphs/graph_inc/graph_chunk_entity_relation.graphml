      <data key="d0">The Baker's</data>
      <data key="d1">organization</data>
      <data key="d2">The Baker's is an external entity mentioned as the location where the Cratchits smelt the goose.</data>
      <data key="d3">chunk-4ff9deb2924e688bbce0e0754c1c6c61&lt;SEP&gt;chunk-d83de16f004bc6df79c898ceebb845ae</data>
