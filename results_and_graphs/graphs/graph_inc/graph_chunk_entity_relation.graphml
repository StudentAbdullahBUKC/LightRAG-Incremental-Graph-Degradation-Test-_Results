    <node id="The Goose">
      <data key="d0">The Goose</data>
      <data key="d1">product</data>
      <data key="d2">The Goose is a central element in the family's celebrations, symbolizing abundance and joy during the holiday season.</data>
      <data key="d3">chunk-4ff9deb2924e688bbce0e0754c1c6c61&lt;SEP&gt;chunk-46e6c7e69332f5941d7559d38ab18692&lt;SEP&gt;chunk-d83de16f004bc6df79c898ceebb845ae</data>
