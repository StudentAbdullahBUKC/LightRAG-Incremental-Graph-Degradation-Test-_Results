      <data key="d5">1778857415</data>
      <data key="d6" />
    </node>
    <node id="Mrs. Cratchit">
      <data key="d0">Mrs. Cratchit</data>
      <data key="d1">person</data>
      <data key="d2">Mrs. Cratchit is Bob's wife, who lays the cloth for dinner and assists her daughters with their tasks.&lt;SEP&gt;Mrs. Cratchit is the mother of several children, concerned about her family's situation during the holiday season.</data>
      <data key="d3">chunk-5f14044ab5836af865c1e895c3e69f02&lt;SEP&gt;chunk-4ff9deb2924e688bbce0e0754c1c6c61&lt;SEP&gt;chunk-0f65a52cdced73f0bcc13216f1ce39e8&lt;SEP&gt;chunk-46e6c7e69332f5941d7559d38ab18692&lt;SEP&gt;chunk-1396694e41876e83b97376904aee5073&lt;SEP&gt;chunk-118ca942f4f3c9502142773f3fdd20d1&lt;SEP&gt;chunk-7d515d836ef3c169d415fdd151180e25&lt;SEP&gt;chunk-d83de16f004bc6df79c898ceebb845ae</data>
