    <node id="Clerk">
      <data key="d0">Clerk</data>
      <data key="d1">person</data>
      <data key="d2">The Clerk is an employee who works for Scrooge and copies letters in a small cell.&lt;SEP&gt;The clerk is an employee working under Scrooge at the counting-house and is tasked with shutting down the office on Christmas Eve.</data>
      <data key="d3">chunk-d2a7ef72626bbee05c0fd8527f6e1957&lt;SEP&gt;chunk-2578f4b9b71e769737a8de262e6b8a26</data>
