    <node id="Summer Flowers">
      <data key="d0">Summer Flowers</data>
      <data key="d1">flora</data>
      <data key="d2">Summer flowers are used to trim the Ghost's tunic, representing growth and renewal.</data>
      <data key="d3">chunk-7f600f0ca86e6d9a0ea0ccce27215b2f</data>
      <data key="d4">unknown_source</data>
